; Survivor Island — Godot phase 0 browser compatibility experiment
config_version=5

[application]
config/name="Survivor Island"
run/main_scene="res://application/game_app.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.51, 0.73, 0.84, 1)

[navigation]
3d/default_cell_size=0.2
3d/default_cell_height=0.1
3d/merge_rasterizer_cell_scale=0.2

[physics]
3d/default_gravity=18.0
